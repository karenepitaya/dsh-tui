{
  "name": "dsh-tui",
  "version": "0.0.0",
  "description": "Cordis-mountable terminal UI plugin for DeepSeek Harness.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karenepitaya/dsh-tui.git"
  },
  "bugs": {
    "url": "https://github.com/karenepitaya/dsh-tui/issues"
  },
  "homepage": "https://github.com/karenepitaya/dsh-tui#readme",
  "keywords": [
    "deepseek",
    "harness",
    "cordis",
    "tui",
    "terminal"
  ],
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node scripts/clean-build.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:approval-contract": "vitest run tests/dsh-interaction-hub.spec.ts -t \"pairs the official service-minted audit id\"",
    "test:model-selection-contract": "vitest run tests/dsh-model-selection.spec.ts -t \"commits the official LLM-resolved reasoning default\"",
    "test:standard-agent-e2e": "vitest run tests/official-dsh-e2e.spec.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --exclude tests/official-dsh-e2e.spec.ts",
    "pack:local": "pnpm run build && node scripts/pack-local.mjs",
    "dev:profile": "pwsh -NoLogo -NoProfile -File scripts/install-local.ps1 -Profile tui -Launch",
    "verify": "pnpm run typecheck && pnpm run test:coverage && pnpm run test:standard-agent-e2e && pnpm run build && node scripts/import-built.mjs && node scripts/loader-built.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-include": "1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-agent-default-model": "0.1.1-rc.2",
    "@deepseek-ai/dsh-cmdline": "0.1.1-rc.2",
    "@deepseek-ai/dsh-commands": "0.1.1-rc.2",
    "@deepseek-ai/dsh-credentials": "0.1.1-rc.2",
    "@deepseek-ai/dsh-goal": "0.1.1-rc.2",
    "@deepseek-ai/dsh-jobs": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session-query": "0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subagent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tool-workflow": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.1.1-rc.2",
    "@deepseek-ai/dsh-user-questions": "0.1.1-rc.2",
    "@types/js-yaml": "4.0.9",
    "@types/node": "^22.20.0",
    "@vitest/coverage-v8": "^4.1.8",
    "@xterm/headless": "5.5.0",
    "js-yaml": "4.1.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-agent-default-model": "0.1.1-rc.2",
    "@deepseek-ai/dsh-cmdline": "0.1.1-rc.2",
    "@deepseek-ai/dsh-commands": "0.1.1-rc.2",
    "@deepseek-ai/dsh-credentials": "0.1.1-rc.2",
    "@deepseek-ai/dsh-goal": "0.1.1-rc.2",
    "@deepseek-ai/dsh-jobs": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session-query": "0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subagent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tool-workflow": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.1.1-rc.2",
    "@deepseek-ai/dsh-user-questions": "0.1.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-jobs": {
      "optional": true
    },
    "@deepseek-ai/dsh-subagent": {
      "optional": true
    },
    "@deepseek-ai/dsh-tool-workflow": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-agent-presets": "0.1.1-rc.2",
    "@deepseek-ai/dsh-authorization": "0.1.1-rc.2",
    "@deepseek-ai/dsh-code-runtime-worker-thread": "0.1.1-rc.2",
    "@deepseek-ai/dsh-cordis-host-runner": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.1",
    "@earendil-works/pi-tui": "0.84.2",
    "commander": "^15.0.0",
    "picocolors": "1.1.1"
  }
}
